<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="car">
   <xacro:include filename="$(find cpp2_slam)/urdf/car/common_inertia.xacro" />

    <xacro:include filename="$(find cpp2_slam)/urdf/car/base.urdf.xacro" />
    <!-- 传感器组件 -->
    <xacro:include filename="$(find cpp2_slam)/urdf/car/sensor/imu.urdf.xacro" />
    <xacro:include filename="$(find cpp2_slam)/urdf/car/sensor/laser.urdf.xacro" />
    <xacro:include filename="$(find cpp2_slam)/urdf/car/sensor/camera.urdf.xacro" />
     <!-- 执行器组件 -->
    <xacro:include filename="$(find cpp2_slam)/urdf/car/actuator/wheel.urdf.xacro" />
    <xacro:include filename="$(find cpp2_slam)/urdf/car/actuator/caster.urdf.xacro" />

    <!-- Gazebo 插件 -->
    <!-- <xacro:include filename="$(find cpp2_slam)/urdf/car/plugins/gazebo_control_plugin.xacro" /> -->
    <xacro:include filename="$(find cpp2_slam)/urdf/car/plugins/gazebo_sensor_plugin.xacro" />
    <!-- gazebo ros2_control插件 -->
    <xacro:include filename="$(find cpp2_slam)/urdf/car/car_ros2_control.xacro" />    


    <xacro:base_xacro length="0.12" radius="0.1" />
    <!-- 传感器 -->
    <xacro:imu_xacro xyz="0 0 0.02" />
    <xacro:laser_xacro xyz="0 0 0.10" />
    <xacro:camera_xacro xyz="0.10 0 0.075" />
    <!-- 执行器主动轮+从动轮 -->
    <xacro:wheel_xacro wheel_name="left" xyz="0 0.10 -0.06" />
    <xacro:wheel_xacro wheel_name="right" xyz="0 -0.10 -0.06" />
    <xacro:caster_xacro caster_name="front" xyz="0.08 0.0 -0.076" />
    <xacro:caster_xacro caster_name="back" xyz="-0.08 0.0 -0.076" />

    <!-- 使用插件 -->
    <!-- <xacro:gazebo_control_plugin/> -->
    <xacro:gazebo_sensor_plugin/>
    <xacro:car_ros2_control/>
    
</robot>
