<!-- 底盘 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="PI" value="3.1415927"/>
    <!-- 底座 -->
    <xacro:property name="car_length" value="1.6"/>
    <xacro:property name="car_width" value="0.7"/>
    <xacro:property name="car_height" value="0.01"/>
    <!-- 轮胎 -->
    <xacro:property name="wheel_radius" value="0.1"/>
    <xacro:property name="wheel_length" value="0.08"/>
    <!-- 离地间距 -->
    <xacro:property name="distance" value="0.1"/>
    <!-- 轮胎关节偏移量 -->
    <xacro:property name="wheel_joint_x" value="0.65"/>
    <xacro:property name="wheel_joint_y" value="${car_width/2 + wheel_length/2}"/>
    <xacro:property name="wheel_joint_z" value="${-(car_height/2 + distance - wheel_radius)}"/>

    <!-- 1.抽取颜色 -->
    <material name="yellow">
        <color rgba="0.9 0.6 0.0 0.5"/>
    </material>    
    <material name="black">
        <color rgba="0.0 0.0 0.0 0.5"/>
    </material>    
    <!-- 2.设置base_footprint -->
    <link name="base_footprint">
        <visual>
            <geometry>
                <sphere radius="0.001"/>
            </geometry>
        </visual>
    </link>
    <!-- 3.设置base_link -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${car_length} ${car_width} ${car_height}"/>
            </geometry>
            <material name="yellow"/>
        </visual>
        <!-- 碰撞信息 gazebo使用 -->
        <collision>
            <geometry>
                <box size="${car_length} ${car_width} ${car_height}"/>
            </geometry>
        </collision>
    </link>
    <!-- 4.joint关联俩者 -->
    <joint name="base_linkbase_footprint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <!-- z偏移 = 车体高度/2 + 离地间距 -->
        <origin xyz="0.0 0.0 ${car_height/2 +distance}"/>
    </joint>
    <!-- 5.定义车轮宏 -->
    <xacro:macro name="wheel_func" params="link_name front_flag left_flag">
        <link name="${link_name}">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <material name="black"/>
                <origin rpy="${PI/2} 0.0 0.0"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <material name="black"/>
                <origin rpy="${PI/2} 0.0 0.0"/>
            </collision>
        </link>
        <joint name="${link_name}base_link" type="continuous">
            <parent link="base_link"/>
            <child link="${link_name}"/>
            <origin xyz="${wheel_joint_x * front_flag} ${wheel_joint_y * left_flag} ${wheel_joint_z}"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
    </xacro:macro>
    <!-- 6.调用宏生成四个车轮 -->
    <xacro:wheel_func link_name="front_left" front_flag="1" left_flag="1"/>
    <xacro:wheel_func link_name="front_right" front_flag="1" left_flag="-1"/>
    <xacro:wheel_func link_name="back_left" front_flag="-1" left_flag="1"/>
    <xacro:wheel_func link_name="back_right" front_flag="-1" left_flag="-1"/>
</robot>